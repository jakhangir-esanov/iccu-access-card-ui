    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.48.0",
